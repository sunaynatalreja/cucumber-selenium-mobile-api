pipeline {
    agent any

    stages {
        stage('Code Pull') {
            steps {
            checkout([$class: 'GitSCM', branches: [[name: 'main']], userRemoteConfigs: [[credentialsId: '6d3a364d-78a9-427f-b80e-02bbf418cfbe',url: 'https://github.com/sunaynatalreja/cucumber-selenium-mobile-api.git']]])
            
            }
        }
        stage('Docker container spinup') {
            steps {
                    sh "pwd"
                    sh 'docker-compose up -d'
                  
            
            }
        }
            stage('Build') {
            steps {
            		withMaven(mavenSettingsConfig: 'c7a7109c-b001-4917-97e7-041b6167b03f')
            		{
            			sh "pwd"
                    	sh 'mvn -B -DskipTests clean package'
                    	sh 'docker ps -a'
                    }
                   
                
            }
            }
            
            stage('test') {
            steps {                
                sh "pwd"
                sh 'mvn test -D${TestNGXML}'
                
            }
            }
            
                       
            stage('Docker container close') {
            steps {
                    sh "pwd"
                    sh 'docker stop $(docker ps -a -q)'
                    sh 'docker rm $(docker ps -a -q)'
                            
            }
        }
        }
    }